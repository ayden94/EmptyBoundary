{
  "name": "@ayden94/empty-boundary",
  "version": "0.1.0",
  "private": true,
  "description": "Typed empty-state signals and a React-only empty boundary.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayden94/EmptyBoundary.git"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "test": "pnpm run build && pnpm run test:runtime && pnpm run test:types",
    "test:runtime": "tsc -p tsconfig.runtime.json && node --test-timeout=10000 --import ./.test-dist/tests/setup-dom.js --test .test-dist/tests/*.test.js",
    "test:types": "tsc -p tsconfig.tests.json",
    "check": "pnpm run lint && pnpm test",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxlint": "^1.81.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "~6.0.2"
  }
}
